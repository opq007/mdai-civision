# --- core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/civision.db
STORAGE_DIR=./data/videos
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- limits ---
RATE_LIMIT_RPM=60
VIDEO_TTL_DAYS=7
WORKER_CONCURRENCY=4
MAX_QUEUE_SIZE=500

# --- accounts ---
SESSION_CHECK_INTERVAL_S=900
SUBMIT_COOLDOWN_S=45
ACCOUNT_ERROR_COOLDOWN_S=60
MAX_ACCOUNT_RETRIES=3
DEFAULT_MAX_CONCURRENCY=1
# Keep an imported account on the egress IP it was validated from. Turn this
# on only if every account is intentionally routed through the proxy pool.
AUTO_ASSIGN_PROXY=false
# httpx honours HTTP_PROXY/HTTPS_PROXY/ALL_PROXY by default. Keep this off so
# a container-level proxy cannot silently change the account's egress IP.
TRUST_ENV_PROXY=false

# --- browser (OAuth capture / renewal) ---
BROWSER_PROFILE_DIR=./.browser-profile
PLAYWRIGHT_HEADLESS=true

# --- alerting ---
ALERT_WEBHOOK_URL=
